<?xml version="1.0" encoding="utf-8"?>
<!-- Privacy: nothing from this app is ever included in backups (learning data stays on the device). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
